# ==========================================
# FinScope v3 - Variables de Entorno (Plantilla)
# ==========================================
# Copia este archivo a '.env' y completa con tus credenciales de Firebase y Google Cloud.
# NUNCA subas el archivo '.env' con valores reales al repositorio.

# Google Identity Services (GIS - Sign in with Google)
VITE_GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# Firebase Cloud Firestore Configuration
VITE_FIREBASE_API_KEY=tu_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu_proyecto_id
VITE_FIREBASE_STORAGE_BUCKET=tu_proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_messaging_sender_id
VITE_FIREBASE_APP_ID=tu_app_id
VITE_FIREBASE_MEASUREMENT_ID=tu_measurement_id
